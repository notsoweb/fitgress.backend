APP_NAME="Argos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://argos.backend.test
APP_FRONTEND_URL=http://argos.frontend.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=America/Mexico_City

CORS_ALLOWED_ORIGINS=*

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

APP_PAGINATION=25

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=argos
DB_USERNAME=argos
DB_PASSWORD=argos

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.maileroo.com
MAIL_PORT=2525
MAIL_DOMAIN=mcortes.dev
MAIL_USERNAME=no-reply@mcortes.dev
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@mcortes.dev"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_BACKUP_TO=soy@mcortes.dev

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CLOUDFLARE_ENDPOINT=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_TOKEN=
CLOUDFLARE_DEFAULT_REGION=auto
CLOUDFLARE_BUCKET=laravel-backup
CLOUDFLARE_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

OPENAI_API_KEY=
GEMINI_API_KEY=

BACKUP_DISKS=backups
BACKUP_NOTIFICATIONS_ROUTES=
DISCORD_WEBHOOK_URL=